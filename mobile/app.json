{
  "expo": {
    "name": "SocialBook",
    "slug": "thesocialbook",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "socialbook",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "imageWidth": 200,
      "backgroundColor": "#0F0B1C"
    },
    "plugins": [
      "./plugins/with-notification-manifest",
      [
        "expo-image-picker",
        {
          "photosPermission": "SocialBook needs access to your photos so you can share them in posts.",
          "cameraPermission": "SocialBook needs camera access so you can take photos for posts."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0F0B1C"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thesocialbook.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:akhil24thakur.github.io"
      ]
    },
    "android": {
      "package": "com.thesocialbook.app",
      "versionCode": 40005,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0F0B1C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "akhil24thakur.github.io",
              "pathPrefix": "/thesocialbook/post"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c45269d6-680e-407c-8828-da5323e9f0f7"
      }
    },
    "owner": "akhilthakur"
  }
}
